# Local AI Runtime Endpoints (100% Local — No Cloud Keys Required)
OLLAMA_URL="http://127.0.0.1:11434"
LOCALVOX_LLM_MODEL="qwen3:1.7b"
LOCALVOX_FALLBACK_MODEL="gemma3:1b"
LOCALVOX_FASTAPI_URL="http://127.0.0.1:8000"
LOCALVOX_STT_MODEL="base"
LOCALVOX_STT_COMPUTE="int8"
LOCALVOX_TTS_ENGINE="piper"
LOCALVOX_MAX_TOOLS="4"
LOCALVOX_TOOL_TIMEOUT="10.0"

# Optional Free Server Hosting Fallback (e.g., 512MB RAM Render/Koyeb where Ollama doesn't fit)
# Any OpenAI-compatible /v1 endpoint (Groq free tier, OpenRouter :free, or remote Ollama /v1)
LLM_API_URL=""
LLM_API_KEY=""
LLM_API_MODEL="qwen/qwen3.8-27b"

# Container / Server Options
PORT="3000"
ENABLE_LOCAL_OLLAMA="true"
ENABLE_PIPER_AUTO_DOWNLOAD="true"

# Clerk Authentication (https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY="YOUR_CLERK_PUBLISHABLE_KEY"
CLERK_PUBLISHABLE_KEY="YOUR_CLERK_PUBLISHABLE_KEY"
CLERK_SECRET_KEY="YOUR_CLERK_SECRET_KEY"

# Supabase Database (https://supabase.com)
SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# GEMINI_API_KEY / APP_URL (Runtime environment placeholders)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
